# Copy to .env and fill in real values. Never commit .env.
# In production, set these in the hosting dashboard instead of a file.

# development | production | test
NODE_ENV=development

# Hosts usually assign this. (macOS uses 5000 for AirPlay, so 4000 is a safe local default.)
PORT=4000

# Use a dedicated MySQL user with privileges only on this database (never root).
# Percent-encode special characters in the password (e.g. "@" becomes "%40").
# allowPublicKeyRetrieval=true is needed for MySQL 8 caching_sha2_password over a non-TLS
# local connection. Use TLS instead of this option for remote/production databases.
DATABASE_URL="mysql://app_user:change_me@localhost:3306/project_management?allowPublicKeyRetrieval=true"
# Production (hosted MySQL with TLS): add ssl=true and drop allowPublicKeyRetrieval, e.g.
#   mysql://<app-user>:<password>@<host>:<port>/<database>?ssl=true
# If the host signs its certificate with its own CA (Aiven does), also set
#   NODE_EXTRA_CA_CERTS=<path to the CA certificate file>
# so the certificate is verified instead of rejected.

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different, newly generated secret in production.
JWT_SECRET=

# 7d in production; 30s to test token expiry locally.
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed web origins (no "*").
# Production: only the deployed web origin, e.g. https://<your-app>.vercel.app
CLIENT_ORIGIN=http://localhost:5173
