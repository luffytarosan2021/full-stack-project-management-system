// Project Management System: Prisma schema (MySQL 8), documentation copy.
//
// This file must stay identical to backend/prisma/schema.prisma (the authoritative schema,
// introspected from the live database). Only this header comment differs.
// docs/schema.sql describes the same tables in SQL and must stay consistent with it.
//
// Notes the schema itself cannot express:
// - Models and fields use the database's snake_case names (no @map). The API uses camelCase;
//   backend serializers convert between the two (e.g. full_name -> fullName).
// - Primary keys have no @default(uuid()). The backend generates IDs with crypto.randomUUID().
// - created_at / updated_at: Prisma fills @default(now()) itself on create.
// - updated_at has no @updatedAt. The database column has ON UPDATE CURRENT_TIMESTAMP, but it only
//   fires when another column value actually changes. Every Prisma update must set
//   updated_at: new Date() explicitly so the timestamp is always maintained by the application.
// - All timestamps are UTC: backend/src/config/prisma.js sets the driver option timezone=Z, so each
//   connection runs SET time_zone = '+00:00' (the MySQL server's own time zone is not changed).
// - @db.Date columns come back as JS Date objects at UTC midnight. The API must return them as
//   plain "YYYY-MM-DD" strings (toISOString().slice(0, 10)) without local-timezone conversion.
// - Database URL and driver adapter are configured in backend/prisma7.config.ts and
//   backend/src/config/prisma.js (Prisma 7 + @prisma/adapter-mariadb), not in this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model projects {
  id          String          @id @db.Char(36)
  user_id     String          @db.Char(36)
  name        String          @db.VarChar(150)
  description String?         @db.Text
  status      projects_status @default(NOT_STARTED)
  start_date  DateTime        @db.Date
  end_date    DateTime        @db.Date
  created_at  DateTime        @default(now()) @db.Timestamp(0)
  updated_at  DateTime        @default(now()) @db.Timestamp(0)
  users       users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_projects_user")
  tasks       tasks[]

  @@index([user_id], map: "idx_projects_user_id")
}

model tasks {
  id          String         @id @db.Char(36)
  project_id  String         @db.Char(36)
  name        String         @db.VarChar(150)
  description String?        @db.Text
  priority    tasks_priority @default(MEDIUM)
  status      tasks_status   @default(PENDING)
  due_date    DateTime       @db.Date
  created_at  DateTime       @default(now()) @db.Timestamp(0)
  updated_at  DateTime       @default(now()) @db.Timestamp(0)
  projects    projects       @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_project")

  @@index([project_id], map: "idx_tasks_project_id")
}

model users {
  id            String     @id @db.Char(36)
  full_name     String     @db.VarChar(100)
  email         String     @unique(map: "email") @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  created_at    DateTime   @default(now()) @db.Timestamp(0)
  updated_at    DateTime   @default(now()) @db.Timestamp(0)
  projects      projects[]
}

enum projects_status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum tasks_priority {
  LOW
  MEDIUM
  HIGH
}

enum tasks_status {
  PENDING
  IN_PROGRESS
  COMPLETED
}
