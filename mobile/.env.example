# Backend API base URL, including the /api prefix (no trailing slash).
# Expo embeds EXPO_PUBLIC_* values in the app bundle, so never put secrets here.
#
# Android emulator:        http://10.0.2.2:4000/api   (10.0.2.2 is the host computer)
# Physical phone (Wi-Fi):  http://<your computer's LAN IP>:4000/api
# Release APK:             https://<your deployed backend>/api   (release builds block plain http)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
