{
  "expo": {
    "name": "HamroProject",
    "slug": "project-management-system",
    "version": "1.0.0",
    "scheme": "pms",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diyashrestha.projectmanagement"
    },
    "android": {
      "package": "com.diyashrestha.projectmanagement",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EEF2FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0316aaf5-043f-432b-8977-2e227143d8bd"
      }
    }
  }
}
